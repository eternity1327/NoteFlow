(request-label darker "Darker chords")
(request-label brighter "Brighter chords")
(request-label simpler "Simpler chords")
(request-label richer "Richer chords")
(request-label faster "Faster")
(request-label slower "Slower")
(request-label groovier "More groove")
(request-label steadier "Steadier rhythm")
(request-label shorter "Shorter song")
(request-label longer "Longer song")
(request-label softer "Softer")
(request-label more-energy "More energy")
(request-label new-lyrics "New lyric theme")

(change darker progression dark 2)
(change darker progression bright -2)
(change darker mood dark 1)
(change brighter progression bright 2)
(change brighter progression dark -2)
(change brighter mood happy 1)
(change simpler harmony triads 2)
(change simpler harmony extended -2)
(change richer harmony extended 2)
(change richer harmony triads -2)
(change faster tempo fast 2)
(change faster tempo slow -2)
(change slower tempo slow 2)
(change slower tempo fast -2)
(change groovier rhythm syncopated 2)
(change groovier rhythm pad -1)
(change steadier rhythm pad 2)
(change steadier rhythm syncopated -2)
(change shorter structure short 2)
(change shorter structure classic -1)
(change longer structure classic 2)
(change longer structure short -1)
(change softer rhythm pad 2)
(change softer rhythm syncopated -1)
(change softer tempo slow 1)
(change softer tempo fast -2)
(change more-energy tempo fast 2)
(change more-energy tempo slow -2)
(change more-energy rhythm syncopated 1)
(change more-energy mood energetic 1)
(change-current new-lyrics theme -2)

(keyword dark darker)
(keyword darker darker)
(keyword sad darker)
(keyword sadder darker)
(keyword moody darker)
(keyword melancholic darker)
(keyword bright brighter)
(keyword brighter brighter)
(keyword happy brighter)
(keyword happier brighter)
(keyword uplifting brighter)
(keyword simple simpler)
(keyword simpler simpler)
(keyword basic simpler)
(keyword rich richer)
(keyword richer richer)
(keyword jazzy richer)
(keyword jazzier richer)
(keyword lush richer)
(keyword complex richer)
(keyword fast faster)
(keyword faster faster)
(keyword upbeat faster)
(keyword energy more-energy)
(keyword energetic more-energy)
(keyword hype more-energy)
(keyword intense more-energy)
(keyword powerful more-energy)
(keyword soft softer)
(keyword softer softer)
(keyword gentle softer)
(keyword gentler softer)
(keyword quiet softer)
(keyword quieter softer)
(keyword mellow softer)
(keyword calmer slower)
(keyword slow slower)
(keyword slower slower)
(keyword calm slower)
(keyword chill slower)
(keyword groove groovier)
(keyword groovier groovier)
(keyword funky groovier)
(keyword bouncy groovier)
(keyword steady steadier)
(keyword steadier steadier)
(keyword smooth steadier)
(keyword short shorter)
(keyword shorter shorter)
(keyword long longer)
(keyword longer longer)
(keyword lyrics new-lyrics)
(keyword words new-lyrics)
